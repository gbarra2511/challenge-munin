# Copy to .env and fill in. .env is gitignored.

# Postgres (local docker-compose default)
DATABASE_URL=postgresql+psycopg://munin:munin@localhost:5432/munin

# Auth — gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
JWT_EXPIRES_MINUTES=720

# Endpoints protegidos
TICK_SECRET=change-me-tick
ADMIN_SECRET=change-me-admin

# Pipeline defaults (sobrescritos por plantão)
DEFAULT_BATCH_SIZE=3
DEFAULT_BATCH_WINDOW_MINUTES=30
DEFAULT_ESCALATE_HOURS_BEFORE=6

# CORS — separar por vírgula
CORS_ORIGINS=http://localhost:3000

# Base pública do frontend — usada nos deep links das notificações
FRONTEND_URL=http://localhost:3000

# WhatsApp via Twilio (sandbox) — credenciais em https://console.twilio.com
# Sem estas variáveis o backend usa o NullNotifier (loga e não envia nada).
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Seu celular (E.164) com opt-in no sandbox. A coordenadora e o médico-demo
# apontam para ele → você recebe ofertas (médico) e pedidos de troca (coord.).
MUNIN_DEMO_PHONE="+55 11 9XXXX-XXXX"

# Opcional — bônus
RESEND_API_KEY=
ANTHROPIC_API_KEY=
