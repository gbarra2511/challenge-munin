# Copy to .env and fill in. .env is gitignored.

# Postgres (local docker-compose default)
DATABASE_URL=postgresql+psycopg://munin:munin@localhost:5432/munin

# Auth — gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
JWT_EXPIRES_MINUTES=720

# Endpoints protegidos
TICK_SECRET=change-me-tick
ADMIN_SECRET=change-me-admin

# Pipeline defaults (sobrescritos por plantão)
DEFAULT_BATCH_SIZE=3
DEFAULT_BATCH_WINDOW_MINUTES=30
DEFAULT_ESCALATE_HOURS_BEFORE=6

# CORS — separar por vírgula
CORS_ORIGINS=http://localhost:3000

# Opcional — bônus
RESEND_API_KEY=
ANTHROPIC_API_KEY=
